# ==============================================================================
# VoltFlow Enterprise - Production Environment Variables Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file and rename it to '.env' for local development.
# 2. For Vercel Production deployment: Add these keys under Project Settings > Environment Variables.
# 3. Obtain values from Firebase Console: Project Settings > General > Your Apps > Web App.
# 4. NEVER commit the active '.env' file containing secrets to GitHub!
# ==============================================================================

# Firebase Web App Credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Initial Admin Bootstrap Credentials for scripts/bootstrapAdmin.js
# BOOTSTRAP_ADMIN_EMAIL=admin@voltflow.com
# BOOTSTRAP_ADMIN_PASSWORD=YourSecureComplexAdminPassword2026!
