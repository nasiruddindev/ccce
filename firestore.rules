rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // AUTHENTICATION & ROLE VALIDATION HELPERS
    // -------------------------------------------------------------------------
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Safely retrieve user document from Firestore
    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user account is active
    function isUserActive() {
      return isAuthenticated() && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserDoc().isActive != false
      );
    }

    // Check if user has Main Admin role (Checks token custom claims or verified Firestore doc)
    function isMainAdmin() {
      return isAuthenticated() && isUserActive() && (
        request.auth.token.role == 'Main Admin' || 
        request.auth.token.isAdmin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc().role == 'Main Admin')
      );
    }

    // Check if user is Branch Engineer
    function isBranchEngineer() {
      return isAuthenticated() && isUserActive() && (
        request.auth.token.role == 'Branch Engineer' || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserDoc().role == 'Branch Engineer')
      );
    }

    // Retrieve the verified substation branch assigned to the engineer
    function getAssignedBranch() {
      return getUserDoc().branchId;
    }

    // -------------------------------------------------------------------------
    // 1. USERS COLLECTION (Role Escalation Protection)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Authenticated users can view user directory
      allow read: if isAuthenticated();

      // Only Main Admin can create user profiles (or initial admin during bootstrap)
      allow create: if isAuthenticated() && (
        isMainAdmin() || request.auth.uid == userId
      );

      // Only Main Admin can update roles, assigned branch, or activation status.
      // Normal users may ONLY update non-sensitive profile details (phone, avatar, displayName).
      allow update: if isAuthenticated() && (
        isMainAdmin() || (
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.branchId == resource.data.branchId &&
          request.resource.data.isActive == resource.data.isActive
        )
      );

      // Only Main Admin can delete user documents
      allow delete: if isMainAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. PRODUCTS & INVENTORY (Direct Modification Protection)
    // -------------------------------------------------------------------------
    match /products/{productId} {
      // Authenticated users can view products catalog and stock levels
      allow read: if isAuthenticated();

      // Engineers must NEVER directly modify inventory or product documents!
      // All stock-changing operations must go through Main Admin or trusted Cloud Functions.
      allow create: if isMainAdmin();
      allow update: if isMainAdmin();
      allow delete: if isMainAdmin();
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isMainAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. BRANCHES & SUBSTATIONS (Central Hub Safeguard)
    // -------------------------------------------------------------------------
    match /branches/{branchId} {
      allow read: if isAuthenticated();
      
      // Admin can create or update branches
      allow create: if isMainAdmin();
      
      // Protect Central Main Hub from deactivation:
      allow update: if isMainAdmin() && (
        resource.data.isMain != true || request.resource.data.status == 'Active'
      );

      // Soft-deletion only: Historical branches must not be hard deleted
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 4. TRANSFERS & CHALLANS (Substation Scope & Idempotency)
    // -------------------------------------------------------------------------
    match /transfers/{transferId} {
      allow read: if isAuthenticated();

      // Main Admin can create transfer from any location.
      // Branch Engineer can ONLY dispatch from their explicitly assigned substation!
      allow create: if isAuthenticated() && (
        isMainAdmin() || (
          isBranchEngineer() && 
          request.resource.data.fromLocationId == getAssignedBranch() &&
          request.resource.data.status == 'in_transit'
        )
      );

      // Status updates:
      // - Main Admin can update transfer.
      // - Receiving Branch Engineer can ONLY confirm receipt for their own destination substation!
      // - Once received, status CANNOT be reverted to 'in_transit'.
      allow update: if isAuthenticated() && (
        isMainAdmin() || (
          isBranchEngineer() &&
          resource.data.toLocationId == getAssignedBranch() &&
          resource.data.status == 'in_transit' &&
          request.resource.data.status == 'received'
        )
      );

      // Immutability: Challans cannot be deleted to preserve shipping audit trails
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 5. STOCK MOVEMENTS (Strict Ledger Immutability)
    // -------------------------------------------------------------------------
    match /movements/{movementId} {
      allow read: if isAuthenticated();
      
      // Stock movement ledger is append-only
      allow create: if isAuthenticated();

      // Ledger records are strictly IMMUTABLE: cannot be updated or deleted by anyone!
      allow update: if false;
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // 6. AUDIT LOGS & SYSTEM ACTIVITY
    // -------------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isMainAdmin();
      allow create: if isAuthenticated();
      allow update: if false;
      allow delete: if false;
    }
  }
}
